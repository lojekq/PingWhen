<Page x:Class="PingWhen.Features.AgentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:PingWhen.Shell"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      xmlns:f="clr-namespace:PingWhen.Features">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24" MaxWidth="900">
            <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.Agents}" Margin="0,0,0,4" />
            <ui:TextBlock Appearance="Secondary" Text="{l:T Agents.Subtitle}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <ui:InfoBar x:Name="MoveBar" Severity="Warning" IsClosable="False" Title="{l:T Agents.Move.Title}" Message="{l:T Agents.Move.Message}" Margin="0,0,0,8" />

            <ui:CardControl Icon="{ui:SymbolIcon PlugConnected24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{l:T Agents.Sessions}" />
                        <ui:TextBlock x:Name="PipeStatus" FontTypography="Caption" Appearance="Secondary" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
            <ItemsControl x:Name="SessionList" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="24,0,0,4" Padding="12,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Bot24" Margin="0,0,10,0" />
                                    <ui:TextBlock Text="{Binding Client}" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text=" · " Appearance="Secondary" />
                                    <ui:TextBlock Text="{Binding Folder}" />
                                </StackPanel>
                                <ui:TextBlock Text="{Binding Details}" Appearance="Secondary" HorizontalAlignment="Right" />
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:Card Margin="0,0,0,4">
                <StackPanel>
                    <Grid>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:T Agents.Mcp}" VerticalAlignment="Center" />
                        <ui:Button x:Name="CopyMcp" HorizontalAlignment="Right" Icon="{ui:SymbolIcon Copy24}" Content="{l:T Agents.Copy}" />
                    </Grid>
                    <ui:TextBlock Text="{l:T Agents.Mcp.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <TextBox x:Name="McpCommand" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,4">
                <StackPanel>
                    <Grid>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{l:T Agents.Hooks}" VerticalAlignment="Center" />
                        <ui:Button x:Name="CopyHooks" HorizontalAlignment="Right" Icon="{ui:SymbolIcon Copy24}" Content="{l:T Agents.Copy}" />
                    </Grid>
                    <ui:TextBlock Text="{l:T Agents.Hooks.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <TextBox x:Name="HooksJson" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    <CheckBox x:Name="ClaudeText" Content="{l:T Agents.ClaudeText}" Margin="0,12,0,0" />
                    <ui:TextBlock Text="{l:T Agents.ClaudeText.Note}" FontTypography="Caption" Appearance="Tertiary" TextWrapping="Wrap" Margin="28,0,0,0" />
                </StackPanel>
            </ui:Card>

            <ui:TextBlock FontTypography="BodyStrong" Text="{l:T Agents.Recent}" Margin="0,12,0,4" />
            <ui:TextBlock x:Name="RecentEmpty" Appearance="Tertiary" Text="{l:T Agents.Recent.Empty}" />
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="{Binding Time}" Appearance="Secondary" />
                            <ui:TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
