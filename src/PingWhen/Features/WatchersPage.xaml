<Page x:Class="PingWhen.Features.WatchersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:PingWhen.Shell"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      xmlns:f="clr-namespace:PingWhen.Features">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24" MaxWidth="900">
            <Grid Margin="0,0,0,16">
                <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.Watchers}" />
                <ui:Button x:Name="NewButton" HorizontalAlignment="Right" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="{l:T Watchers.New}" />
            </Grid>
            <ui:InfoBar x:Name="ErrorBar" Severity="Error" Title="{l:T Watchers.DeliveryError}" IsClosable="False" Margin="0,0,0,8" />
            <StackPanel x:Name="EmptyPanel" Margin="0,24,0,0">
                <ui:TextBlock Appearance="Secondary" Text="{l:T Watchers.Empty}" TextWrapping="Wrap" />
                <ui:TextBlock Appearance="Tertiary" Text="{l:T Watchers.EmptyHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
            <ItemsControl ItemsSource="{x:Static f:Cards.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type f:Card}">
                        <ui:CardControl Margin="0,0,0,4" Icon="{Binding Icon}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                                    <ui:TextBlock Text="{Binding Condition}" FontTypography="Caption" Appearance="Secondary" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <ui:TextBlock Text="{Binding Live}" FontTypography="Caption" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <ui:TextBlock Text="{Binding Author}" FontTypography="Caption" Appearance="Tertiary" Margin="12,0,0,0" />
                                    </StackPanel>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,4,0,0" Width="240" HorizontalAlignment="Left" Visibility="{Binding ProgressVisibility}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding Elapsed}" HorizontalAlignment="Right" />
                                    <ui:TextBlock Text="{Binding Channels}" FontTypography="Caption" Appearance="Secondary" HorizontalAlignment="Right" />
                                </StackPanel>
                                <ui:Button Content="{l:T Watchers.Edit}" Margin="0,0,4,0" Click="Edit_Click" Tag="{Binding}" />
                                <ui:Button Content="{l:T Watchers.Cancel}" Click="Cancel_Click" Tag="{Binding}" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
