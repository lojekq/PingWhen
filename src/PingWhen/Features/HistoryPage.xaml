<Page x:Class="PingWhen.Features.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:PingWhen.Shell"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24,12,24,24" MaxWidth="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <ui:TextBlock FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T Page.History}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox x:Name="FilterBox" MinWidth="160" DisplayMemberPath="Text" Margin="0,0,8,0" />
                <ui:Button x:Name="ClearButton" Content="{l:T History.Clear}" Icon="{ui:SymbolIcon Delete24}" />
            </StackPanel>
        </Grid>
        <ui:TextBlock x:Name="EmptyText" Grid.Row="1" Appearance="Secondary" Text="{l:T History.Empty}" />
        <ListBox x:Name="List" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,6" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Text="{Binding Time}" Appearance="Secondary" VerticalAlignment="Center" />
                        <Border Grid.Column="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding Badge}">
                            <TextBlock Text="{Binding Outcome}" Foreground="White" FontSize="12" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                            <ui:TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <ui:TextBlock Text="{Binding Body}" FontTypography="Caption" Appearance="Secondary" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ui:TextBlock Grid.Column="3" Text="{Binding Duration}" Appearance="Secondary" VerticalAlignment="Center" />
                        <ui:TextBlock Grid.Column="4" Text="{Binding Channels}" Appearance="Secondary" VerticalAlignment="Center" FontTypography="Caption" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
