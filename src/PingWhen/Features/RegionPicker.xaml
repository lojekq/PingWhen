<ui:FluentWindow x:Class="PingWhen.Features.RegionPicker"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:PingWhen.Shell"
                 Title="{l:T Region.Title}" Width="1000" Height="720" MinWidth="600" MinHeight="400"
                 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{l:T Region.Title}" ShowMinimize="False" />
        <ui:TextBlock Grid.Row="1" Text="{l:T Region.Hint}" Appearance="Secondary" TextWrapping="Wrap" Margin="16,0,16,8" />
        <Viewbox Grid.Row="2" Margin="16,0,16,0" Stretch="Uniform">
            <Grid>
                <Image x:Name="Shot" Stretch="None" />
                <Canvas x:Name="Overlay" Background="Transparent" Cursor="Cross">
                    <Rectangle x:Name="Box" Stroke="#FF0A84FF" StrokeThickness="4" Fill="#330A84FF" Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </Viewbox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button x:Name="WholeButton" Content="{l:T Region.Whole}" Margin="0,0,8,0" />
            <ui:Button x:Name="OkButton" Appearance="Primary" Content="{l:T Region.Ok}" IsDefault="True" MinWidth="100" Margin="0,0,8,0" />
            <ui:Button x:Name="CancelButton" Content="{l:T New.Cancel}" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
