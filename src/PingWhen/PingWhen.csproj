<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>                    <!-- no console window -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>        <!-- some CsWin32 APIs need it -->
    <StartupObject>PingWhen.Program</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.0.0-dev</Version>                       <!-- CI takes the real version from the git tag -->
    <Product>PingWhen</Product>
    <AssemblyTitle>PingWhen</AssemblyTitle>
    <Description>PingWhen</Description>
    <Company>lojekq</Company>
    <Copyright>© 2026 lojekq · MIT</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Own Program.Main: verbs run before WPF, so App.xaml is a Page, not ApplicationDefinition -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\*.ico" />
    <InternalsVisibleTo Include="PingWhen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.358" PrivateAssets="all" />
  </ItemGroup>

</Project>
