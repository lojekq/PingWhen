<ui:FluentWindow x:Class="PingWhen.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:PingWhen.Shell"
                 xmlns:f="clr-namespace:PingWhen.Features"
                 Title="{x:Static l:AppInfo.Title}" Width="1100" Height="700" MinWidth="720" MinHeight="480"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{x:Static l:AppInfo.Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="12,0,12,0">
            <ui:InfoBar x:Name="ElevatedBar" Severity="Warning" IsClosable="False" Margin="0,0,0,8"
                        Title="{l:T Elevated.Title}" Message="{l:T Elevated.Message}" />
            <ui:InfoBar x:Name="UpdateBar" Severity="Informational" Margin="0,0,0,8" Title="{l:T Update.Title}">
                <ui:HyperlinkButton x:Name="UpdateLink" Content="{l:T Update.Open}" Padding="0" />
            </ui:InfoBar>
        </StackPanel>

        <!-- App pages go into MenuItems; TargetPageTag is the page id for the page flag and Navigate("id") -->
        <ui:NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False" OpenPaneLength="220">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:T Page.Watchers}" Icon="{ui:SymbolIcon Eye24}"
                                       TargetPageType="{x:Type f:WatchersPage}" TargetPageTag="main" />
                <ui:NavigationViewItem Content="{l:T Page.New}" Icon="{ui:SymbolIcon AddCircle24}"
                                       TargetPageType="{x:Type f:NewWatcherPage}" TargetPageTag="new" />
                <ui:NavigationViewItem Content="{l:T Page.History}" Icon="{ui:SymbolIcon History24}"
                                       TargetPageType="{x:Type f:HistoryPage}" TargetPageTag="history" />
                <ui:NavigationViewItem Content="{l:T Page.Agents}" Icon="{ui:SymbolIcon Bot24}"
                                       TargetPageType="{x:Type f:AgentsPage}" TargetPageTag="agents" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{l:T Page.Settings}" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type l:SettingsPage}" TargetPageTag="settings" />
                <ui:NavigationViewItem Content="{l:T Page.About}" Icon="{ui:SymbolIcon Info24}"
                                       TargetPageType="{x:Type l:AboutPage}" TargetPageTag="about" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
